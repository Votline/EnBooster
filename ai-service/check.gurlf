[grpc_config]
Target:localhost:50053
Endpoint:ai.AIService/Generate
Data:`
    {
        "uuid": "{RANDOM oneof=uuid}",
        "text": "hgf",
        "request_trace": "{RANDOM oneof=uuid}"
    }
`
ProtoPath:{VARIABLE key=aisrvproto ; default=../protos/ai.proto}
ID:0
Type:grpc
Certs:{VARIABLE key=cacrt ; default=../gateway/ssl/ca.crt}
Response:{"text":"Right then. Let's hear it. What’s got your goat? Don't be shy, and try not to overthink it. The world's a messy place, anyway.  Just tell us what happened...or what *will* happen if you're that keen on waiting for the problem. Go on, spill!"}
[\grpc_config]

